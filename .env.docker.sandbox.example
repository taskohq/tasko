# Sandbox-only values for compose.sandbox.yaml, which uses host networking.
TASKO_POSTGRES_URL=postgresql://tasko:tasko_dev_only@127.0.0.1:5432/tasko?sslmode=disable
TASKO_REDIS_URL=redis://127.0.0.1:6379
TASKO_STORAGE_BACKEND=s3
TASKO_S3_ENDPOINT=http://127.0.0.1:9000
TASKO_S3_REGION=us-east-1
TASKO_S3_BUCKET=tasko-dev
TASKO_S3_ACCESS_KEY_ID=tasko_minio_dev
TASKO_S3_SECRET_ACCESS_KEY=tasko_minio_dev_only_change_me
TASKO_S3_FORCE_PATH_STYLE=true
DEPLOYMENT_PROFILE=single_tenant
TASKO_SINGLE_TENANT_SLUG=tasko-demo
